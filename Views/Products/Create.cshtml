@model TEST1_SCADA.Models.SanPham

<h2>Thêm sản phẩm</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Id"></label>
        <input asp-for="Id" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MaSanPham">Mã Sản Phẩm</label>
        <input asp-for="MaSanPham" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="TenSanPham">Tên Sản Phẩm</label>
        <textarea asp-for="TenSanPham" class="form-control"></textarea>
    </div>

    <br />
    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
