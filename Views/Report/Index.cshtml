@{
    ViewData["Title"] = "Báo cáo PLC";
    Layout = "_Layout";
}

<div class="container py-3">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center mb-3 text-center">
        <h4 class="mb-0 text-primary fw-bold">Bảng thông số đánh giá</h4>
    </div>


    <!-- Bộ lọc -->
    <div class="card shadow-sm border-0 mb-3 mx-auto" style="max-width: 900px;">
        <div class="card-body">
            <div class="row g-1 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold">Dây chuyền</label>
                    <select id="rpLine" class="form-select">
                        <option>Dây chuyền 1</option>
                        <option>Dây chuyền 2</option>
                        <option>Dây chuyền 3</option>
                        <option>Dây chuyền 4</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold">Máy</label>
                    <select id="rpMachine" class="form-select">
                        <option>Máy 1</option>
                        <option>Máy 2</option>
                        <option>Máy 3</option>
                        <option>Máy 4</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold">Ca</label>
                    <select id="rpShift" class="form-select">
                        <option>Ca 1</option>
                        <option>Ca 2</option>
                        <option>Ca 3</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 text-md-end">
                    <button type="button" id="btnReportView" class="btn btn-primary px-4">Xem</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng báo cáo -->
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
            <span>Bảng chỉ số</span>
            <span class="small opacity-75">Cập nhật: <span id="updatedAt">--:--:--</span></span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:160px;">Nhóm</th>
                            <th>Chỉ số</th>
                            <th class="text-end" style="width:240px;">Giá trị</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- SẴN SÀNG -->
                        <tr>
                            <td class="fw-bold text-primary text-center align-middle" rowspan="5">SẴN SÀNG</td>
                            <td>MTTR [phút]</td>
                            <td class="text-end fw-bold">
                                <span id="vMTTR">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>MTBF [giờ]</td>
                            <td class="text-end fw-bold">
                                <span id="vMTBF">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% Dừng máy [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vStopPct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% Hỏng máy [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vFaultPct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Availability Rate [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vA">--</span>
                            </td>
                        </tr>

                        <!-- ỔN ĐỊNH -->
                        <tr>
                            <td class="fw-bold text-primary text-center align-middle" rowspan="4">ỔN ĐỊNH</td>
                            <td>Tổn thất tốc độ [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vSpeedLossPct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Tốc độ trung bình [gói/phút]</td>
                            <td class="text-end fw-bold">
                                <span id="vVtb">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% Thời gian dừng nhỏ [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vMinorStopPct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Performance Rate [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vP">--</span>
                            </td>
                        </tr>

                        <!-- CHẤT LƯỢNG -->
                        <tr>
                            <td class="fw-bold text-primary text-center align-middle" rowspan="3">CHẤT LƯỢNG</td>
                            <td>% Gói cấn gia vị [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vSpicePct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% Gói rỗng [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vEmptyPct">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>Quality Rate [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vQ">--</span>
                            </td>
                        </tr>

                        <!-- HIỆU SUẤT -->
                        <tr>
                            <td class="fw-bold text-primary text-center align-middle" rowspan="3">HIỆU SUẤT</td>
                            <td>% OEE 1 [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vOEE1">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% OEE 2 [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vOEE2">--</span>
                            </td>
                        </tr>
                        <tr>
                            <td>% OEE 3 [%]</td>
                            <td class="text-end fw-bold">
                                <span id="vOEE3">--</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white d-flex flex-wrap gap-2 justify-content-end">
            <button type="button" id="btnExportExcel" class="btn btn-success">Xuất Excel</button>
            <button type="button" id="btnExportWord" class="btn btn-primary">In báo cáo</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function pad2(n){ return String(n).padStart(2,"0"); }
        const d = new Date();
        document.getElementById("updatedAt").textContent =
            `${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
    </script>
    @*JS cho nút "XEM" (Gọi PLC để đọc dữ liệu lên bảng)*@
    <script>
        const $ = (id) => document.getElementById(id);

        function setText(id, val) {
          const el = $(id);
          if (el) el.textContent = (val ?? "--");
        }
        let plcConnected = false;

        async function connectPlc() {
          const r = await fetch("/plc/connect", { method: "POST" });
          const j = await r.json().catch(()=> ({}));
          plcConnected = (!!j.success && r.ok);
          $("btnReportView").disabled = !plcConnected;
          return { ok: plcConnected, msg: j.status || "" };
        }

        function parseNum(selectId, fallback = 1) {
          const t = $(selectId)?.value || "";
          const m = t.match(/\d+/);
          return m ? Number(m[0]) : fallback;
        }

        async function loadReportFromPlc() {
          const line = parseNum("rpLine", 1);
          const machine = parseNum("rpMachine", 1);
          const caSo = parseNum("rpShift", 1);

          const c = await connectPlc();
          if (!c.ok) {
            alert("Kết nối PLC thất bại: " + c.msg);
            return;
          }

          const url = `/Report/ReadSave?line=${encodeURIComponent(line)}&machine=${encodeURIComponent(machine)}&caSo=${encodeURIComponent(caSo)}`;
          const r = await fetch(url, { cache: "no-store" });
          const j = await r.json();

         if (!j.ok) {
            alert(j.message || "Chưa kết nối đến PLC!");
            return;
        }

          const d = j.data;
          if (!d) {
            alert("Không có j.data để fill bảng.");
            return;
          }

          setText("updatedAt", j.updatedAt);

          setText("vMTTR", d.mttr);
          setText("vMTBF", d.mtbf);
          setText("vStopPct", d.stopPct);
          setText("vFaultPct", d.faultPct);
          setText("vA", d.a);

          setText("vSpeedLossPct", d.speedLossPct);
          setText("vVtb", d.vtb);
          setText("vMinorStopPct", d.minorStopPct);
          setText("vP", d.p);

          setText("vSpicePct", d.spicePct);
          setText("vEmptyPct", d.emptyPct);
          setText("vQ", d.q);

          setText("vOEE1", d.oeE1);
          setText("vOEE2", d.oeE2);
          setText("vOEE3", d.oeE3);
        }

        document.addEventListener("DOMContentLoaded", () => {
          document.getElementById("btnReportView")?.addEventListener("click", loadReportFromPlc);
        });
    </script>
    @*JS cho xuất excel và in báo cáo word*@
    <script>
          function parseNum(selectId, fallback = 1) {
          const t = document.getElementById(selectId)?.value || "";
          const m = t.match(/\d+/);
          return m ? Number(m[0]) : fallback;
        }

        function getQuery() {
          const line = parseNum("rpLine", 1);
          const machine = parseNum("rpMachine", 1);
          const caSo = parseNum("rpShift", 1);
          return { line, machine, caSo };
        }

        document.getElementById("btnExportExcel")?.addEventListener("click", () => {
          const q = getQuery();
          window.location.href = `/Report/ExportExcel?line=${q.line}&machine=${q.machine}&caSo=${q.caSo}`;
        });

        document.getElementById("btnExportWord")?.addEventListener("click", () => {
          const q = getQuery();
          window.location.href = `/Report/ExportWord?line=${q.line}&machine=${q.machine}&caSo=${q.caSo}`;
        });

    </script>
}
