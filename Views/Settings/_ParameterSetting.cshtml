@using TEST1_SCADA.Models
@{
    var sanPhams = ViewBag.SanPham as List<SanPham> ?? new List<SanPham>();
}
<div class="card shadow-sm border-primary">
    <div class="card-header bg-primary text-white fw-bold text-center">
        CÀI ĐẶT THÔNG SỐ
    </div>
</div>
</br>
<div class="mx-auto" style="max-width: 750px">
    <div class="border border-dark p-3 mb-3 bg-primary bg-opacity-25">

        <div class="row mb-2 align-items-center">
            <div class="col-4">
                <label for="paramDayChuyen" class="form-label fw-bold mb-0"> Tên dây chuyền </label>
            </div>
            <div class="col-8">
                <select id="paramDayChuyen" name="paramDayChuyen" class="form-select form-select-sm">
                    <option>Dây chuyền 1</option>
                    <option>Dây chuyền 2</option>
                    <option>Dây chuyền 3</option>
                    <option>Dây chuyền 4</option>
                </select>
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-4">
                <label for="paramTenMay" class="form-label fw-bold mb-0"> Tên máy </label>
            </div>
            <div class="col-8">
                <select id="paramTenMay" name="paramTenMay" class="form-select form-select-sm">
                    <option>Máy 1</option>
                    <option>Máy 2</option>
                    <option>Máy 3</option>
                    <option>Máy 4</option>
                </select>
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-4">
                <label for="paramCa" class="form-label fw-bold mb-0"> Ca </label>
            </div>
            <div class="col-8">
                <select id="paramCa" name="paramCa" class="form-select form-select-sm">
                    <option>Ca 1</option>
                    <option>Ca 2</option>
                    <option>Ca 3</option>
                </select>
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-4">
                <label for="paramSanPhamSelect" class="form-label fw-bold mb-0">Mã sản phẩm</label>
            </div>
            <div class="col-8">
                <select id="paramSanPhamSelect" name="paramSanPhamSelect" class="form-select form-select-sm">
                    <option>[ALL]</option>
                    @foreach (var sp in sanPhams)
                    {
                        <option value="@sp.Id" data-name="@sp.TenSanPham">@sp.MaSanPham</option>
                    }
                </select>
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-4">
                <label for="paramTenSanPham" class="form-label fw-bold mb-0"> Tên sản phẩm </label>
            </div>
            <div class="col-8">
                <input id="paramTenSanPham" name="paramTenSanPham" class="form-control" readonly value="[ALL]" />
            </div>
        </div>
    </div>

    <div class="border border-dark p-3 mb-3 bg-primary bg-opacity-10">
        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramTocDo" class="form-label fw-bold mb-0">Tốc độ chuẩn [gói/phút]</label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramTocDo" name="paramTocDo"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập tốc độ chuẩn > 0" />
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramDungMay" class="form-label fw-bold mb-0"> Thời gian dừng máy [s] </label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramDungMay" name="paramDungMay"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập thời gian dừng máy > 0" />
            </div>
        </div>


        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramChapNhan" class="form-label fw-bold mb-0"> Thời gian chấp nhận gói [x0.1s] </label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramChapNhan" name="paramChapNhan"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập thời gian chấp nhận gói > 0" />
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramGoiCan" class="form-label fw-bold mb-0"> Thời gian gói cân [x0.1s] </label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramGoiCan" name="paramGoiCan"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập thời gian gói cân > 0" />
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramDayGoiCan" class="form-label fw-bold mb-0"> Thời gian đẩy gói cân [x0.1s]</label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramDayGoiCan" name="paramDayGoiCan"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập thời gian đẩy gói cân > 0" />
            </div>
        </div>

        <div class="row mb-2 align-items-center">
            <div class="col-5">
                <label for="paramCapNhatPLC" class="form-label fw-bold mb-0"> Thời gian cập nhật từ PLC [s]</label>
            </div>
            <div class="col-7">
                <input type="number" min="0" id="paramCapNhatPLC" name="paramCapNhatPLC"
                       class="form-control pos-int" inputmode="numeric" autocomplete="off"
                       placeholder="Nhập thời gian cập nhật từ PLC > 0" />
            </div>
        </div>
    </div>
</div>

<!-- KẾT NỐI PLC -->
<div class="text-center mb-3">
    <button type="button" id="btnConnectPlc" class="btn btn-primary">
        Kết nối PLC
    </button>

    <span id="plcStatus" class="fw-semibold text-danger">
        Disconnected
    </span>
</div>


<!-- BUTTON -->
<div class="text-center mb-3">
    <button type="button" id="btnSaveParam" class="btn btn-success me-2 px-4">
        Thiết Lập
    </button>
    <button type="button" id="btnWritePlc" class="btn btn-success px-4">
        Ghi Xuống
    </button>
</div>

@section Scripts {
    <script>
        const POS_INT = /^[1-9]\d*$/;

        function showInvalid(el, msg) {
          el.classList.add("is-invalid");
          let fb = el.nextElementSibling;
          if (!fb || !fb.classList.contains("invalid-feedback")) {
            fb = document.createElement("div");
            fb.className = "invalid-feedback";
            el.insertAdjacentElement("afterend", fb);
          }
          fb.textContent = msg || "Vui lòng nhập số nguyên dương.";
        }

        function clearInvalid(el) {
          el.classList.remove("is-invalid");
          const fb = el.nextElementSibling;
          if (fb && fb.classList.contains("invalid-feedback")) fb.textContent = "";
        }

        function validatePosInt(el) {
          const v = (el.value || "").trim();

          if (v === "") { showInvalid(el, "Không được để trống."); return false; }

          // bắt mọi trường hợp có dấu '-' hoặc '.' hoặc chữ
          if (!POS_INT.test(v)) {
            showInvalid(el, "Chỉ được nhập số nguyên dương (1,2,3...). Không nhập số âm/chữ/thập phân.");
            return false;
          }

          clearInvalid(el);
          return true;
        }

        // chỉ cho phép nhập: 0-9 và dấu '-' (để còn bắt lỗi), còn lại bỏ
        function sanitize(el) {
          let v = el.value || "";
          v = v.replace(/[^\d-]/g, "");     // bỏ chữ cái
          v = v.replace(/(?!^)-/g, "");     // chỉ cho '-' xuất hiện ở đầu
          el.value = v;
        }

        function validateAllPosInt() {
          const inputs = document.querySelectorAll("input.pos-int");
          let ok = true;
          inputs.forEach(el => { if (!validatePosInt(el)) ok = false; });
          return ok;
        }

        document.addEventListener("DOMContentLoaded", () => {
          document.querySelectorAll("input.pos-int").forEach(el => {
            el.addEventListener("input", () => {
              sanitize(el);
              validatePosInt(el);
            });
            el.addEventListener("blur", () => validatePosInt(el));
          });

          // chặn chắc cả Thiết lập + Ghi xuống (kể cả handler ở file JS khác)
          document.addEventListener("click", (e) => {
            const id = e.target?.id;
            if (id !== "btnSaveParam" && id !== "btnWritePlc") return;

            if (!validateAllPosInt()) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              alert("Vui lòng nhập đúng SỐ NGUYÊN DƯƠNG cho tất cả thông số!");
            }
          }, true);
        });
    </script>
    @*JS để lấy dữ liệu mới nhất hiển thị lên trang cài đặt thông số*@
    <script>
        const $ = (id) => document.getElementById(id);

        function getCtx() {
          return {
            tenDayChuyen: $("paramDayChuyen")?.value || "",
            tenMay: $("paramTenMay")?.value || "",
            ca: $("paramCa")?.value || ""
          };
        }

        function fillSetting(d) {
          if (!d) return;

          // nếu bạn muốn set cả mã SP theo bản mới nhất:
          if ($("paramSanPhamSelect") && d.sanPhamId != null) {
            $("paramSanPhamSelect").value = String(d.sanPhamId);
            // nếu bạn đang có code auto-fill tên SP theo data-name thì trigger change:
            $("paramSanPhamSelect").dispatchEvent(new Event("change"));
          }

          $("paramTocDo").value = d.tocDoChuan ?? "";
          $("paramDungMay").value = d.thoiGianDungMay ?? "";
          $("paramChapNhan").value = d.thoiGianChapNhanGoi ?? "";
          $("paramGoiCan").value = d.thoiGianGoiCan ?? "";
          $("paramDayGoiCan").value = d.thoiGianDayGoiCan ?? "";
          $("paramCapNhatPLC").value = d.thoiGianCapNhatTuPLC ?? "";
        }

        async function loadLatestSetting() {
          const ctx = getCtx();
          const url = `/Settings/GetLatestParameterSetting?tenDayChuyen=${encodeURIComponent(ctx.tenDayChuyen)}&tenMay=${encodeURIComponent(ctx.tenMay)}&ca=${encodeURIComponent(ctx.ca)}`;

          const r = await fetch(url, { cache: "no-store" });
          const j = await r.json().catch(() => null);

          if (!j || !j.ok) return;

          fillSetting(j.data);
        }

        document.addEventListener("DOMContentLoaded", () => {
          // 1) mở/reload trang: tự nạp bản mới nhất
          loadLatestSetting();

          // 2) đổi dây chuyền/máy/ca: nạp bản mới nhất theo lựa chọn mới
          ["paramDayChuyen", "paramTenMay", "paramCa"].forEach(id => {
            $(id)?.addEventListener("change", loadLatestSetting);
          });
        });
    </script>

}


