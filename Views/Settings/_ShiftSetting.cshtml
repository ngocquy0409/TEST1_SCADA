@* _ShiftSetting.cshtml *@
@using TEST1_SCADA.Models
@{
    var truongCas = ViewBag.TruongCa as List<TruongCa> ?? new List<TruongCa>();
}
<div class="card shadow-sm border-primary">
    <div class="card-header bg-primary text-white fw-bold text-center">
        CÀI ĐẶT CA SẢN XUẤT
    </div>
</div>
</br>
<form>
    <div class="mx-auto" style="max-width: 1000px">
        <div class="border border-dark p-3 mb-3 bg-primary bg-opacity-25 pt-3">
            <!-- CA 1 -->
            <fieldset class="border border-3 border-dark p-3 mb-4 rounded">
                <legend class="w-auto px-2 fw-bold">Ca 1</legend>

                <div class="row mb-3 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label">Thời gian bắt đầu</label>
                    </div>
                    <div class="col-md-2">
                        <select id="gio1" class="form-select">
                            <option>5</option>
                            <option>6</option>
                            <option>7</option>
                        </select>
                    </div>
                    <div class="col-md-1">Giờ</div>
                    <div class="col-md-2">
                        <select id="phut1" class="form-select">
                            <option>00</option>
                            <option selected>30</option>
                        </select>
                    </div>
                    <div class="col-md-1">Phút</div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaSelect1" class="form-label">Mã trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <select id="truongCaSelect1" name="truongCaSelect1" class="form-select">
                            <option>[Chọn Trưởng Ca]</option>
                            @foreach (var tc in truongCas)
                            {
                            <option value="@tc.Id" data-name="@tc.HovaTen">@tc.MaTruongCa</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaName1" class="form-label">Trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <input id="truongCaName1" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>

            <!-- CA 2 -->
            <fieldset class="border border-3 border-dark p-3 mb-4 rounded">
                <legend class="w-auto px-2 fw-bold">Ca 2</legend>

                <div class="row mb-3 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label">Thời gian bắt đầu</label>
                    </div>
                    <div class="col-md-2">
                        <select id="gio2" class="form-select">
                            <option>13</option>
                            <option>14</option>
                            <option>15</option>
                        </select>
                    </div>
                    <div class="col-md-1">Giờ</div>
                    <div class="col-md-2">
                        <select id="phut2" class="form-select">
                            <option>00</option>
                            <option selected>30</option>
                        </select>
                    </div>
                    <div class="col-md-1">Phút</div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaSelect2" class="form-label">Mã trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <select id="truongCaSelect2" name="truongCaSelect1" class="form-select">
                            <option>[Chọn Trưởng Ca]</option>
                            @foreach (var tc in truongCas)
                            {
                                <option value="@tc.Id" data-name="@tc.HovaTen">@tc.MaTruongCa</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaName2" class="form-label">Trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <input id="truongCaName2" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>

            <!-- CA 3 -->
            <fieldset class="border border-3 border-dark p-3 mb-4 rounded">
                <legend class="w-auto px-2 fw-bold">Ca 3</legend>

                <div class="row mb-3 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label">Thời gian bắt đầu</label>
                    </div>
                    <div class="col-md-2">
                        <select id="gio3" class="form-select">
                            <option>22</option>
                            <option>23</option>
                            <option>24</option>
                        </select>
                    </div>
                    <div class="col-md-1">Giờ</div>
                    <div class="col-md-2">
                        <select id="phut3" class="form-select">
                            <option>00</option>
                            <option selected>30</option>
                        </select>
                    </div>
                    <div class="col-md-1">Phút</div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaSelect3" class="form-label">Mã trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <select id="truongCaSelect3" name="truongCaSelect1" class="form-select">
                            <option>[Chọn Trưởng Ca]</option>
                            @foreach (var tc in truongCas)
                            {
                                <option value="@tc.Id" data-name="@tc.HovaTen">@tc.MaTruongCa</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="truongCaName3" class="form-label">Trưởng ca</label>
                    </div>
                    <div class="col-md-7">
                        <input id="truongCaName3" class="form-control" readonly />
                    </div>
                </div>
            </fieldset>

            <!-- BUTTON -->
            <div class="text-center">
                <button type="button" id="btnXacNhan" class="btn btn-primary px-4 me-5">Xác nhận</button>
                <button type="button" class="btn btn-danger px-4">
                    Hủy
                </button>
            </div>
        </div>
    </div>
    

</form>
