@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<h4 class="mb-4">Cài đặt hệ thống</h4>

<ul class="nav nav-tabs" id="settingTabs" role="tablist">

    <li class="nav-item" role="presentation">
        <button class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#shift">
            Ca sản xuất
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#production">
            Nhập sản lượng
        </button>
    </li>

    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#parameter">
                Thông số
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#general">
                Chung
            </button>
        </li>
    }

</ul>

<div class="tab-content border border-top-0 p-4 bg-white">

    <!-- CA SẢN XUẤT -->
    <div class="tab-pane fade show active" id="shift">
        @await Html.PartialAsync("_ShiftSetting")
    </div>

    <!-- NHẬP SẢN LƯỢNG -->
    <div class="tab-pane fade" id="production">
        @await Html.PartialAsync("_ProductionInput")
    </div>

    <!-- ADMIN -->
    @if (User.IsInRole("Admin"))
    {
        <div class="tab-pane fade" id="parameter">
            @await Html.PartialAsync("_ParameterSetting")
        </div>

        <div class="tab-pane fade" id="general">
            @await Html.PartialAsync("_GeneralSetting")
        </div>
    }

</div>
@section Scripts {
    <script>
        console.log("JS SETTINGS ĐÃ LOAD");

        function themTruongCa() {
            let ma = document.getElementById("ma_truong_ca").value;
            let ten = document.getElementById("Ho_va_ten").value;
            if(!ma || !ten){
                alert("Vui lòng nhập đầy đủ thông tin của Trưởng Ca!");
                return;
            }
            fetch('/Settings/AddTruongCa', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `maTruongCa=${ma}&hoVaTen=${ten}`
            })
            .then(res => res.json())
            .then(data => {
                let table = document.querySelector("#tblTruongCa tbody");
                let rowCount = table.rows.length + 1;
                let row = table.insertRow();
                row.setAttribute("data-id", data.id);
                row.setAttribute("onclick", "chonDong(this,'truongca')");

                row.innerHTML = `
                    <td>${rowCount}</td>
                    <td>${data.maTruongCa}</td>
                    <td>${data.hovaTen}</td>
                `;
                document.getElementById("ma_truong_ca").value = "";
                document.getElementById("Ho_va_ten").value = "";
            })
            .catch(err => console.error(err));
        }
    </script>
    <script>
        function themSanPham() {
            let ma = document.getElementById("Ma_san_pham").value;
            let ten = document.getElementById("Ten_san_pham").value;

            fetch('/Settings/AddSanPham', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `maSanPham=${ma}&tenSanPham=${ten}`
            })
            .then(res => res.json())
            .then(data => {
                @*cập nhật danh sách thả xuống cho cài đặt ca sản xuất *@
                console.log("server trả về:", data); 
                ["truongCaSelect1","truongCaSelect2","truongCaSelect3"].forEach(id=>{
                    const sel = document.getElementById(id);
                    if(!sel) return;

                        // tránh trùng mã
                    const exists = Array.from(sel.options).some(o => o.text.trim() === data.maTruongCa);
                    if (exists) return;

                const opt = document.createElement("option");
                opt.value = data.id;
                opt.textContent = data.maTruongCa;
                opt.setAttribute("data-name", data.hovaTen);
                sel.appendChild(opt);
                });
                @* thêm vào bảng *@
                let table = document.querySelector("#tblSanPham tbody");
                let rowCount = table.rows.length + 1;

                let row = table.insertRow();
                row.setAttribute("data-id", data.id);
                row.setAttribute("onclick", "chonDong(this,'sanpham')");

                row.innerHTML = `
                    <td>${rowCount}</td>
                    <td>${data.maSanPham}</td>
                    <td>${data.tenSanPham}</td>
                `;

                // clear input
                document.getElementById("Ma_san_pham").value = "";
                document.getElementById("Ten_san_pham").value = "";
            })
            .catch(err => console.error(err));
        }
    </script>
    <!--JS auto-fill tên trưởng ca-->
    <script>
        document.addEventListener("change", function (e) {
          const el = e.target;
          if (!el) return;

          const map = {
            "truongCaSelect1": "truongCaName1",
            "truongCaSelect2": "truongCaName2",
            "truongCaSelect3": "truongCaName3"
          };

          const inputId = map[el.id];
          if (!inputId) return;

          const opt = el.options[el.selectedIndex];
          const name = opt?.getAttribute("data-name") || "";
          const input = document.getElementById(inputId);
          if (input) input.value = name;
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
          fetch('/Settings/GetShiftConfig')
            .then(r => r.json())
            .then(list => {
              list.forEach(c => {
                const ca = c.caSo ?? c.CaSo; // phòng trường hợp json trả PascalCase
                const gio = c.gioBatDau ?? c.GioBatDau;
                const phut = c.phutBatDau ?? c.PhutBatDau;
                const tcId = c.truongCaId ?? c.TruongCaId;

                // set giờ/phút nếu bạn có id gio1/phut1...
                const gioEl = document.getElementById("gio" + ca);
                const phutEl = document.getElementById("phut" + ca);
                if (gioEl) gioEl.value = gio;
                if (phutEl) phutEl.value = phut;

                // set dropdown trưởng ca
                const sel = document.getElementById("truongCaSelect" + ca);
                if (sel) {
                  sel.value = String(tcId);
                  sel.dispatchEvent(new Event('change')); // ✅ bắt buộc để tự điền tên
                }
              });
            })
            .catch(err => console.error("Load ShiftConfig lỗi:", err));
        });
    </script>

    <!--JS cho nút "Xác nhận"-->
    <script>
        document.getElementById("btnXacNhan")?.addEventListener("click", function () {

          const payload = [
            {
              caSo: 1,
              gioBatDau: parseInt(document.getElementById("gio1").value),
              phutBatDau: parseInt(document.getElementById("phut1").value),
              truongCaId: parseInt(document.getElementById("truongCaSelect1").value || "0")
            },
            {
              caSo: 2,
              gioBatDau: parseInt(document.getElementById("gio2").value),
              phutBatDau: parseInt(document.getElementById("phut2").value),
              truongCaId: parseInt(document.getElementById("truongCaSelect2").value || "0")
            },
            {
              caSo: 3,
              gioBatDau: parseInt(document.getElementById("gio3").value),
              phutBatDau: parseInt(document.getElementById("phut3").value),
              truongCaId: parseInt(document.getElementById("truongCaSelect3").value || "0")
            }
          ];

          // validate
          if (payload.some(x => x.truongCaId === 0)) {
            alert("Vui lòng chọn trưởng ca cho cả 3 ca!");
            return;
          }

          fetch('/Settings/SaveShiftConfig', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(r => {
            if (!r.ok) throw new Error("Save failed");
            alert("Đã lưu cấu hình ca sản xuất!");
          })
          .catch(err => {
            console.error(err);
            alert("Lưu thất bại!");
          });
        });
    </script>
    <!--Tự load config khi mở trang-->
    <script>
        fetch('/Settings/GetShiftConfig')
          .then(r => r.json())
          .then(list => {
            list.forEach(c => {
              document.getElementById("gio" + c.caSo).value = c.gioBatDau;
              document.getElementById("phut" + c.caSo).value = String(c.phutBatDau).padStart(2, '0');
              document.getElementById("truongCaSelect" + c.caSo).value = c.truongCaId;

              // trigger change để auto-fill tên
              document.getElementById("truongCaSelect" + c.caSo).dispatchEvent(new Event('change'));
            });
          });
    </script>
    <script>
        function fillNameForCa(caSo) {
          const sel = document.getElementById("truongCaSelect" + caSo);
          const input = document.getElementById("truongCaName" + caSo);
          if (!sel || !input) return;

          const opt = sel.options[sel.selectedIndex];
          input.value = opt?.getAttribute("data-name") || "";
        }

        // Load config khi vào trang
        document.addEventListener("DOMContentLoaded", function () {
          fetch('/Settings/GetShiftConfig')
            .then(r => r.json())
            .then(list => {
              list.forEach(c => {
                const ca = c.caSo ?? c.CaSo;
                const gio = c.gioBatDau ?? c.GioBatDau;
                const phut = c.phutBatDau ?? c.PhutBatDau;
                const tcId = c.truongCaId ?? c.TruongCaId;

                const gioEl = document.getElementById("gio" + ca);
                const phutEl = document.getElementById("phut" + ca);
                if (gioEl) gioEl.value = String(gio);
                if (phutEl) phutEl.value = String(phut).padStart(2, "0");

                const sel = document.getElementById("truongCaSelect" + ca);
                if (sel) sel.value = String(tcId);

                // fill tên ngay (không phụ thuộc event)
                fillNameForCa(ca);
              });
            })
            .catch(err => console.error("GetShiftConfig lỗi:", err));
        });
    </script>

    @*auto-fill tên sản phẩm khi chọn*@
    <script>
        document.addEventListener("change", function(e){
          if(e.target.id !== "sanPhamSelect") return;
          const opt = e.target.options[e.target.selectedIndex];
          const name = opt?.getAttribute("data-name") || "";
          document.getElementById("tenSanPham").value = name;
        });
    </script>
    @*tự nhập khi load lại trang*@
    <script>
        document.addEventListener("DOMContentLoaded", function(){
          document.getElementById("sanPhamSelect")?.dispatchEvent(new Event("change"));
        });
    </script>

    @*JS nút "Xác nhận" của trang "nhập sản lượng để lưu DB*@
    <script>
        document.getElementById("btnSaveProduction")?.addEventListener("click", function(){

          const ngay = document.getElementById("ngaySanXuat").value; // input type="date"
          const sanPhamId = parseInt(document.getElementById("sanPhamSelect").value || "0");
          const caSo = Number(document.getElementById("caSo").value);
          if (!Number.isFinite(caSo) || caSo <= 0) return alert("Chọn ca!");

          const dayChuyen = document.getElementById("dayChuyen").value;
          const sanLuong = parseInt(document.getElementById("sanLuongThuc").value || "0");

          if(!ngay) return alert("Chọn ngày sản xuất!");
          if(sanPhamId <= 0) return alert("Chọn mã sản phẩm!");
          if(caSo <= 0) return alert("Chọn ca!");
          if(!dayChuyen) return alert("Chọn dây chuyền!");

          const payload = {
            ngaySanXuat: ngay,
            sanPhamId: sanPhamId,
            caSo: caSo,
            dayChuyen: dayChuyen,
            sanLuongThuc: sanLuong
          };

          fetch("/Settings/SaveProductionInput", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
            })

          .then(async r=>{
            const text = await r.text();
            if(!r.ok) return alert("Lưu thất bại: " + text);
            alert("Đã lưu nhập sản lượng!");
            loadProductionTable();
          })
          .catch(err=>{
            console.error(err);
            alert("Lưu thất bại (JS)");
          });
        });
    </script>
    @*Load bảng khi mở trang và reload bảng sau khi lưu*@
    <script>
        function loadProductionTable(){
          fetch("/Settings/GetProductionInputs")
            .then(r => r.json())
            .then(list => {
              const tb = document.querySelector("#tblProduction tbody");
              if(!tb) return;

              tb.innerHTML = "";

              list.forEach(x => {
                const date = new Date(x.ngaySanXuat).toLocaleDateString("vi-VN");
                tb.insertAdjacentHTML("beforeend", `
                  <tr>
                    <td>${x.id}</td>
                    <td>${date}</td>
                    <td>${x.maSanPham}</td>
                    <td>${x.tenSanPham}</td>
                    <td>Ca ${x.caSo}</td>
                    <td>${x.dayChuyen}</td>
                    <td>${x.sanLuongThuc}</td>
                  </tr>
                `);
              });
            })
            .catch(err => console.error("loadProductionTable error:", err));
        }

        document.addEventListener("DOMContentLoaded", loadProductionTable);
    </script>
    <script>
        document.querySelector('button[data-bs-target="#production"]')
          ?.addEventListener("shown.bs.tab", function () {
            loadProductionTable();
          });
    </script>
    @*Auto0fill tên sản phẩm khi chọn mã sản phẩm cho trang cài đặt thông số*@
    <script>
        document.addEventListener("change", function(e){
          if(e.target.id !== "paramSanPhamSelect") return;
          const opt = e.target.options[e.target.selectedIndex];
          const name = opt?.getAttribute("data-name") || "";
          const input = document.getElementById("paramTenSanPham");
          if(input) input.value = name;
        });
    </script>
    @*Thiết lập, post jsson lên /Settings/SaveParameterSetting*@
    <script>
        function toIntOrNull(v){
          const n = parseInt(v, 10);
          return Number.isFinite(n) ? n : null;
        }

        document.getElementById("btnSaveParam")?.addEventListener("click", function(){
          const caiDat = document.getElementById("rdCaiDat")?.checked ?? true;

          const payload = {
            caiDatThamSo: caiDat,
            tenDayChuyen: document.getElementById("paramDayChuyen")?.value || "",
            tenMay: document.getElementById("paramTenMay")?.value || "",
            ca: document.getElementById("paramCa")?.value || "",

            sanPhamId: toIntOrNull(document.getElementById("paramSanPhamSelect")?.value),

            tocDoChuan: toIntOrNull(document.getElementById("paramTocDo")?.value),
            thoiGianDungMay: toIntOrNull(document.getElementById("paramDungMay")?.value),
            thoiGianChapNhanGoi: toIntOrNull(document.getElementById("paramChapNhan")?.value),
            thoiGianGoiCan: toIntOrNull(document.getElementById("paramGoiCan")?.value),
            thoiGianDayGoiCan: toIntOrNull(document.getElementById("paramDayGoiCan")?.value),
            thoiGianCapNhatTuPLC: toIntOrNull(document.getElementById("paramCapNhatPLC")?.value)
          };

          if(!payload.tenDayChuyen) return alert("Nhập tên dây chuyền!");
          if(!payload.tenMay) return alert("Nhập tên máy!");
          if(!payload.ca) return alert("Chọn ca!");

          fetch("/Settings/SaveParameterSetting", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          })
          .then(async r=>{
            const t = await r.text();
            if(!r.ok) return alert("Lưu thất bại: " + t);
            alert("Đã lưu thông số!");
          })
          .catch(err=>{
            console.error(err);
            alert("Lưu thất bại (JS)");
          });
        });
    </script>
    @*Tự load bản khi mới nhất và đổ lên form khi mở tab thông số*@
    <script>
        function loadLatestParam(){
          fetch("/Settings/GetLatestParameterSetting")
            .then(r=>r.json())
            .then(d=>{
              if(!d) return;

              document.getElementById("rdCaiDat").checked = !!d.caiDatThamSo;
              document.getElementById("rdKhongCaiDat").checked = !d.caiDatThamSo;

              document.getElementById("paramDayChuyen").value = d.tenDayChuyen || "";
              document.getElementById("paramTenMay").value = d.tenMay || "";
              document.getElementById("paramCa").value = d.ca || "";

              if(d.sanPhamId){
                document.getElementById("paramSanPhamSelect").value = String(d.sanPhamId);
                document.getElementById("paramSanPhamSelect")?.dispatchEvent(new Event("change"));
              }

              document.getElementById("paramTocDo").value = d.tocDoChuan ?? "";
              document.getElementById("paramDungMay").value = d.thoiGianDungMay ?? "";
              document.getElementById("paramChapNhan").value = d.thoiGianChapNhanGoi ?? "";
              document.getElementById("paramGoiCan").value = d.thoiGianGoiCan ?? "";
              document.getElementById("paramDayGoiCan").value = d.thoiGianDayGoiCan ?? "";
              document.getElementById("paramCapNhatPLC").value = d.thoiGianCapNhatTuPLC ?? "";
            })
            .catch(console.error);
        }

        document.querySelector('button[data-bs-target="#parameter"]')
          ?.addEventListener("shown.bs.tab", loadLatestParam);
    </script>
    @*JS auto-fill tên sản phẩm khi chọn mã sản phẩm*@
    <script>
        document.addEventListener("change", function(e){
          if(e.target.id !== "paramSanPhamSelect") return;

          const opt = e.target.options[e.target.selectedIndex];
          const name = opt?.getAttribute("data-name") || "[ALL]";
          const input = document.getElementById("paramTenSanPham");
          if(input) input.value = name;
        });
    </script>
    @*JS cho nút "Ghi xuống" cho tab thông số*@
    <script>
        function lastNumber(text) {
          const m = (text || "").match(/(\d+)/g);
          if (!m) return 0;
          return parseInt(m[m.length - 1], 10) || 0;
        }

        document.getElementById("btnWritePlc")?.addEventListener("click", async function (e) {
          e.preventDefault();

          const payload = {
            tocDoChuan: parseInt(document.getElementById("paramTocDo").value || "0", 10),
            thoiGianDungMay: parseInt(document.getElementById("paramDungMay").value || "0", 10),
            chapNhanGoi_x01s: parseInt(document.getElementById("paramChapNhan").value || "0", 10),
            goiCan_x01s: parseInt(document.getElementById("paramGoiCan").value || "0", 10),
            dayGoiCan_x01s: parseInt(document.getElementById("paramDayGoiCan").value || "0", 10),
            capNhatTuPLC_s: parseInt(document.getElementById("paramCapNhatPLC").value || "0", 10),

            caSo: lastNumber(document.getElementById("paramCa").value),
            dayChuyen: lastNumber(document.getElementById("paramDayChuyen").value),
            may: lastNumber(document.getElementById("paramTenMay").value),

            sanPhamId: parseInt(document.getElementById("paramSanPhamSelect").value || "0", 10)
          };

          const r = await fetch("/Plc/WriteParameters", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          const data = await r.json().catch(()=>null);
          if (!r.ok) return alert("Ghi PLC thất bại: " + (data?.message || "Unknown"));

          alert(data?.message || "OK");
        });
    </script>
    @*Xử lý nút nhấn cho PLC*@
    <script>
        document.getElementById("btnConnectPlc")?.addEventListener("click", function () {
          fetch("/Plc/Connect", { method: "POST" })
            .then(r => r.json())
            .then(data => {
              const st = document.getElementById("plcStatus");
              if (!st) return;

              // data.status là chuỗi bạn đang return từ controller
              st.textContent = data.status || "Unknown";
              const ok = (data.status || "").toLowerCase().includes("thành công");
              st.classList.toggle("text-success", ok);
              st.classList.toggle("text-danger", !ok);
            })
            .catch(err => {
              console.error(err);
              const st = document.getElementById("plcStatus");
              if (st) {
                st.textContent = "Lỗi kết nối PLC!";
                st.classList.add("text-danger");
                st.classList.remove("text-success");
              }
            });
        });
    </script>

    <script src="~/js/general-setting.js"></script>

}

