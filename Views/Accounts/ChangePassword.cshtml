@model TEST1_SCADA.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}


@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<div class="container">
    <div class="min-vh-100 d-flex align-items-center justify-content-center" style="padding-top: 10px; padding-bottom: 130px;">
        <div class="card shadow-sm" style="width: 100%; max-width: 520px;">
            <div class="card-body p-4">
                <h3 class="mb-4 text-center">@ViewData["Title"]</h3>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="OldPassword"></label>
                        <input asp-for="OldPassword" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                    </div>

                    <button class="btn btn-primary">Đổi mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>
